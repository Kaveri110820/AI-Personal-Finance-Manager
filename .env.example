# Google AI Studio API key. Get one at https://aistudio.google.com/apikey
# Leave empty to run the app with the built-in rule-based fallback engine.
GEMINI_API_KEY=

# Gemini model used for categorization, savings advice, insights and report
# summaries. gemini-2.5-flash is a good free-tier default.
GEMINI_MODEL=gemini-3.5-flash
